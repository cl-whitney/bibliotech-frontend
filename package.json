{
	"name": "bibliotech-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"format": "pnpx @biomejs/biome format ./",
		"format:fix": "pnpx @biomejs/biome format --write ./",
		"lint": "pnpx @biomejs/biome lint ./",
		"lint:fix": "pnpx @biomejs/biome lint --write ./",
		"check": "pnpx @biomejs/biome check ./",
		"check:fix": "pnpx @biomejs/biome check --write ./"
	},
	"dependencies": {
		"axios": "^1.12.2",
		"dotenv": "^17.2.3",
		"lucide-vue-next": "^0.552.0",
		"prismjs": "^1.30.0",
		"vue": "^3.5.22",
		"vue-router": "^4.6.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.7",
		"@types/node": "^24.6.0",
		"@types/prismjs": "^1.26.5",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@vitejs/plugin-react": "^5.0.4",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vue/test-utils": "^2.4.6",
		"@vue/tsconfig": "^0.8.1",
		"jsdo": "^4.3.12",
		"jsdom": "^27.0.1",
		"typescript": "~5.9.3",
		"vite": "^7.1.7",
		"vitest": "^4.0.2",
		"vue-tsc": "^3.1.0"
	}
}
